# ── Required ────────────────────────────────────────────────
# Postgres. Can be the SAME database as SimReal Sync: every table here is prefixed rd_.
DATABASE_URL=
# Random secret for signing sessions: openssl rand -base64 32
AUTH_SECRET=

# ── Sign-in (enable at least one) ───────────────────────────
TEAM_PASSCODE=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAIL_DOMAINS=simreal.ai
ALLOWED_EMAILS=

# ── Channels that need credentials (all optional) ───────────
# X / Twitter API v2 bearer token (recent search). Without it, capture posts with the bookmarklet.
X_BEARER_TOKEN=
# Reddit "script" app (reddit.com/prefs/apps). Reddit blocks most unauthenticated requests from cloud IPs.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# GitHub token raises the search rate limit (no scopes needed).
GITHUB_TOKEN=

# ── AI (optional) ───────────────────────────────────────────
# With a key: Claude classifies new signals and writes the weekly brief.
# Without: rule-based classification + "analyze in Claude/ChatGPT" with your own subscription.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ── Schedules & notifications (optional) ───────────────────
# Protects /api/cron/*; Vercel sends it automatically for its own cron jobs.
CRON_SECRET=
# Lark / Feishu custom bot webhook (can also be set in Settings).
LARK_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
