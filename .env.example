# ── Required ────────────────────────────────────────────────
# Postgres connection string. On Vercel: Storage → Create → Neon, which sets this automatically.
DATABASE_URL=
# Random secret for signing sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=

# ── Sign-in (enable at least one) ───────────────────────────
# Google sign-in (recommended). Create an OAuth client at console.cloud.google.com
# Redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub sign-in (optional). Callback URL: https://<your-domain>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Team passcode sign-in (zero setup): anyone with this passcode can join.
TEAM_PASSCODE=

# Who may sign in with Google/GitHub besides invited members (comma-separated)
ALLOWED_EMAIL_DOMAINS=simreal.ai
ALLOWED_EMAILS=

# ── AI extraction (optional but recommended) ────────────────
# Without it, SimReal falls back to rule-based extraction.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# ── Daily digest (optional) ─────────────────────────────────
SLACK_WEBHOOK_URL=
# Vercel sets this for cron requests automatically when defined in project env
CRON_SECRET=
